<div class="ticket-container">
    <h2 class="ticket-heading conf-heading text-center">
        Congrats, <span class="name-colored">Jonatan Kristof!</span> Your ticket is ready.
    </h2>
    <p class="ticket-info text-center">We've emailed your ticket to <span
            class="participant-mail">jonatan@email.com</span> and will send
        updates in the run up to the event.</p>
    <div class="ticket position-relative">
        <img class src="/dist/images/pattern-ticket.svg" alt="ticket-pattern">
        <div class="ticket-details-top position-absolute d-flex align-items-start gap-2">
            <img class="ticket-logo" src="/dist/images/logo-mark.svg" alt="conference logo">
            <div>
                <h3 class="ticket-conf-name">Coding Conf</h3>
                <p class="date-place">Jan 31, 2025 / Austin, TX</p>
            </div>
        </div>
        <div class="ticket-details-bottom position-absolute d-flex gap-3 p-3">
            <img class="user-avatar" src="/dist/images/image-avatar.jpg" alt="user-image">
            <div class="d-flex flex-column">
                <h4 class="participant-name m-0 p-0">Jonatan Kristof</h4>
                <p class="github-name d-flex align-items-center m-0 p-0">
                    <img class="me-1" src="/dist/images/icon-github.svg" alt="github logo">
                    @jonatankristof0101
                </p>
            </div>
        </div>
        <p class="ticket-code position-absolute">#01609</p>
    </div>
</div>