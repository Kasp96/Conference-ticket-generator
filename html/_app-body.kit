<div class="app-body d-flex flex-column d-none">

    <div class="upload-box d-flex flex-column">
        <label class="label" for="file-input">Upload Avatar</label>
        <div class="upload-box-content d-flex flex-column align-items-center">
            <label class="file-input" for="file-input">
                <img class="upload-img-icon mx-auto p-2" src="/dist/images/icon-upload.svg" alt="upload icon">
                <p class="upload-text">Drag and drop or click to upload</p>
            </label>
            <input class="d-none" type="file" id="file-input">
        </div>
        <p class="hint d-flex align-items-center gap-2">
            <img src="/dist/images/icon-info.svg" alt="hint image">
            Upload your photo (JPG or PNG, max size: 500KB).
        </p>
    </div>
    <div class="name-box d-flex flex-column">
        <label class="label" for="name">Full Name</label>
        <input class="input" type="text">
    </div>
    <div class="email-box d-flex flex-column">
        <label class="label" for="email">Email Address</label>
        <input class="input" type="text" placeholder="example@email.com">
    </div>
    <div class="github-box d-flex flex-column">
        <label class="label" for="GitHub-name">GitHub Username</label>
        <input class="input" type="text" placeholder="@yourusername">
    </div>
    <div class="generate-btn text-center">Generate My Ticket</div>



</div>