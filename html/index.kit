    <!-- @include 'styles.kit' -->
</head>

<body class="position-relative">
    <div class="patterns-top position-absolute w-100 h-100 z-n1 overflow-hidden"></div>
    <div class="patterns-bottom position-absolute"></div>
    <div class="app-container position-relative d-flex flex-column align-items-center overflow-hidden">
        <header class="app-header d-flex flex-column align-items-center text-center">
            <div class="app-name-container d-flex align-items-center gap-3">
                <img class="conf-logo" src="./dist/images/logo-mark.svg" alt="conference logo">
                <h2 class="conf-name my-auto">Coding Conf</h2>
            </div>
        </header>
        <main>
            <!-- @include 'app-body.kit' -->
            <!-- @include 'ticket.kit' -->
        </main>
    </div>
    <!-- @include 'scripts.kit' -->
</body>

</html>